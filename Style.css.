/* =================================
   NOVERASITE COMPANY ADMIN
   Main Stylesheet
================================= */

:root {
    --primary: #1e3a5f;
    --secondary: #2563a6;
    --background: #f3f6fb;
    --white: #ffffff;
    --text: #1e293b;
    --muted: #64748b;
    --border: #e2e8f0;
    --success: #16a34a;
    --danger: #dc2626;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.6;
}

/* HEADER */

header {
    background: var(--primary);
    color: white;
    padding: 22px 30px;
}

header h1 {
    font-size: 26px;
    font-weight: 700;
}

header p {
    color: #cbd5e1;
}

/* NAVIGATION */

nav {
    background: var(--white);
    padding: 15px 25px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

nav a {
    text-decoration: none;
    color: var(--primary);
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 7px;
}

nav a:hover {
    background: #eaf1fa;
}

/* SIDEBAR */

.sidebar {
    width: 240px;
    min-height: 100vh;
    background: var(--primary);
    color: white;
    padding: 25px 15px;
}

.sidebar a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 12px;
    border-radius: 7px;
    margin-bottom: 6px;
}

.sidebar a:hover {
    background: var(--secondary);
}

/* MAIN CONTENT */

main,
.main-content {
    padding: 30px;
}

.container {
    width: 100%;
    max-width: 1200px;
    margin: auto;
}

/* CARDS */

.card,
.stat-card {
    background: var(--white);
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.04);
    margin-bottom: 20px;
}

.card h2,
.card h3 {
    margin-bottom: 15px;
}

/* DASHBOARD GRID */

.dashboard-grid,
.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.stat-card h3 {
    color: var(--muted);
    font-size: 15px;
}

.stat-card p {
    font-size: 27px;
    font-weight: bold;
    color: var(--primary);
}

/* BUTTONS */

button,
.btn {
    background: var(--secondary);
    color: white;
    border: none;
    padding: 11px 18px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: 600;
}

button:hover,
.btn:hover {
    background: var(--primary);
}

/* INPUTS */

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    margin: 8px 0 15px;
    border: 1px solid var(--border);
    border-radius: 7px;
    font-size: 15px;
}

input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #93c5fd;
    border-color: var(--secondary);
}

/* TABLE */

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
    margin-top: 15px;
}

th,
td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

th {
    background: #eaf1fa;
    color: var(--primary);
}

/* STATUS */

.status-active {
    color: var(--success);
    font-weight: bold;
}

.status-pending {
    color: #d97706;
    font-weight: bold;
}

.status-inactive {
    color: var(--danger);
    font-weight: bold;
}

/* FOOTER */

footer {
    text-align: center;
    padding: 20px;
    color: var(--muted);
}

/* MOBILE RESPONSIVE */

@media (max-width: 768px) {
    header {
        padding: 18px;
    }

    main,
    .main-content {
        padding: 18px;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
    }

    .dashboard-grid,
    .stats-grid {
        grid-template-columns: 1fr;
    }

    nav {
        padding: 10px;
    }

    table {
        display: block;
        overflow-x: auto;
    }
}
